export VIRTUAL_ENV_DISABLE_PROMPT=1

# Activate project-wide Python venv (created by install.sh)
_DACO="$(dirname "$DIRENV_FILE")/DaCo/bin/activate"
if [ -f "$_DACO" ]; then
    source "$_DACO"
    export DIRENV_VENV_NAME="DaCo"
else
    echo "[direnv] DaCo venv not found — run: bash install.sh"
fi

# ROS 2 Humble
if [ -f /opt/ros/humble/setup.bash ]; then
    source /opt/ros/humble/setup.bash
fi

# uarm ROS 2 workspace (built by install.sh)
UARM_SETUP="$(dirname "$DIRENV_FILE")/install/setup.bash"
[ -f "$UARM_SETUP" ] && source "$UARM_SETUP"
